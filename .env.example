# --- Database ---
POSTGRES_USER=borrowbetter
POSTGRES_PASSWORD=borrowbetter
POSTGRES_DB=borrowbetter
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://borrowbetter:borrowbetter@db:5432/borrowbetter

# --- Docker images / PyPI (network restrictions) ---
# Docker Hub returns 403 from some networks (e.g. Iran) and files.pythonhosted.org
# times out, so docker-compose and the Dockerfile default to these mirrors.
# Uncomment/override to change them:
# POSTGRES_IMAGE=docker.arvancloud.ir/library/postgres:16-alpine
# PYTHON_IMAGE=docker.arvancloud.ir/library/python:3.12-slim
# PIP_INDEX_URL=https://mirror-pypi.runflare.com/simple
#
# Outside such networks use: postgres:16-alpine / python:3.12-slim / https://pypi.org/simple
#
# Host port for the dockerized database. 5433 avoids clashing with a local PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

# --- App ---
APP_NAME=BorrowBetter
APP_ENV=dev
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Auth ---
SECRET_KEY=change-me-in-production-please-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Booking rules (B) ---
MIN_DURATION_HOURS=1
MAX_DURATION_DAYS=30
PENDING_EXPIRE_HOURS=24
SUGGESTION_COUNT=3

# --- Frontend ---
VITE_API_BASE=http://localhost:8000/api/v1
